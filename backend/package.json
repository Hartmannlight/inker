{
  "name": "inker-backend",
  "version": "0.6.0",
  "description": "Inker Server Backend - E-ink Device Management",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "22.22.3"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "bun run nest start",
    "start:dev": "bun --watch run src/main.ts",
    "start:debug": "bun --watch --inspect run src/main.ts",
    "start:prod": "bun run dist/main.js",
    "start:worker": "bun run src/worker.ts",
    "start:worker:prod": "bun run dist/worker.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "bun run lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:migrations": "bun test ./test/migrations.integration.ts",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "prisma:validate": "DATABASE_URL=file:./uploads/inker.db prisma validate",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bun run scripts/migrate-database.ts",
    "prisma:migrate:status": "bunx prisma migrate status",
    "prisma:studio": "bunx prisma studio",
    "prisma:seed": "bun run prisma/seed.ts",
    "db:seed": "bun run prisma:seed"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@inker/contracts": "file:../contracts",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "^6.2.0",
    "axios": "^1.13.5",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "ioredis": "5.11.1",
    "joi": "^17.11.0",
    "liquidjs": "^10.25.1",
    "nest-winston": "^1.9.4",
    "passport": "^0.7.0",
    "puppeteer": "^23.11.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "0.32.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.1",
    "winston": "^3.11.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.1.1",
    "prisma": "^6.2.0",
    "supertest": "^6.3.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": "^6.14.1",
    "basic-ftp": "^5.2.0",
    "lodash": "^4.17.23",
    "js-yaml": "^4.1.1"
  }
}
