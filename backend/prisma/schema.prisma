// Inker Database Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id                   Int       @id @default(autoincrement())
  name                 String    @map("label")
  friendlyId           String?   @map("friendly_id")
  // Generic device identity. Existing rows are backfilled by the defaults below.
  // TRMNL keeps macAddress/apiKey for protocol compatibility; new device types do not need them.
  deviceType           String    @default("trmnl") @map("device_type")
  transport            String    @default("pull")
  externalId           String?   @unique @map("external_id")
  capabilities         Json?
  configuration        Json?
  telemetry            Json?
  profileId            String    @map("profile_id")
  capabilitiesOverride Json?     @map("capabilities_override")
  deliveryPolicyId     String    @map("delivery_policy_id")
  macAddress           String?   @unique @map("mac_address")
  apiKey               String?   @unique @map("api_key")
  pairingTokenHash     String?   @unique @map("pairing_token_hash")
  pairingExpiresAt     DateTime? @map("pairing_expires_at")
  lastConnectedAt      DateTime? @map("last_connected_at")
  presentationRevision Int       @default(0) @map("presentation_revision")
  firmwareVersion      String?   @map("firmware_version")
  modelId              Int?      @map("model_id")
  playlistId           Int?      @map("playlist_id")
  isActive             Boolean   @default(true) @map("is_active")
  wifi                 Int       @default(0)
  battery              Float     @default(0)
  refreshRate          Int       @default(900) @map("refresh_rate")
  imageTimeout         Int       @default(0) @map("image_timeout")
  width                Int       @default(0)
  height               Int       @default(0)
  proxy                Boolean   @default(false)
  firmwareUpdate       Boolean   @default(true) @map("firmware_update")
  sleepStartAt         String?   @map("sleep_start_at")
  sleepStopAt          String?   @map("sleep_stop_at")
  showSleepScreen      Boolean   @default(false) @map("show_sleep_screen")
  lastSeenAt           DateTime? @map("last_seen_at")
  refreshPending       Boolean   @default(false) @map("refresh_pending")
  lastScreenId         String?   @map("last_screen_id") // Track last displayed screen for ghosting prevention
  screenStartedAt      DateTime? @map("screen_started_at") // When the current screen started displaying
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  model             Model?                   @relation(fields: [modelId], references: [id])
  playlist          Playlist?                @relation(fields: [playlistId], references: [id])
  logs              DeviceLog[]
  credentials       DeviceCredential[]
  enrollments       DeviceEnrollment[]
  screenAssignments DeviceScreenAssignment[]
  profile           DeviceProfile            @relation(fields: [profileId], references: [profileId])
  deliveryPolicy    DeliveryPolicy           @relation(fields: [deliveryPolicyId], references: [policyId])
  publicationState  DevicePublicationState?
  playbackState     PlaybackState?

  @@map("devices")
}

// Versioned profile contract plus the complete default capability view used as
// the base for per-device overrides. Profile rows are shared and immutable by
// identity; changing a built-in definition requires a new profileId.
model DeviceProfile {
  profileId           String   @id @map("profile_id")
  protocolVersion     String   @map("protocol_version")
  label               String
  definition          Json
  defaultCapabilities Json     @map("default_capabilities")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("device_profiles")
}

// Delivery policy is persisted separately from profiles because power source
// and operating mode may differ for devices with the same physical profile.
model DeliveryPolicy {
  policyId        String   @id @map("policy_id")
  protocolVersion String   @map("protocol_version")
  mode            String
  definition      Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("delivery_policies")
}

// Long-lived device credentials are stored as hashes so a database backup never
// contains a usable browser-display token. Multiple credentials allow rotation.
model DeviceCredential {
  id           Int       @id @default(autoincrement())
  credentialId String    @unique @default(cuid()) @map("credential_id")
  deviceId     Int       @map("device_id")
  kind         String    @default("device")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_credentials")
}

// A short pairing code is a one-time bootstrap only. The canonical code and the
// issued device credential never cross this persistence boundary in plaintext.
model DeviceEnrollment {
  enrollmentId String    @id @default(cuid()) @map("enrollment_id")
  deviceId     Int       @map("device_id")
  codeHash     String    @unique @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, usedAt])
  @@index([expiresAt])
  @@map("device_enrollments")
}

// WP-12 deliberately keeps exactly one installation-wide administrator while
// making credentials their own records. A later user model can remove the
// scopeKey uniqueness without rewriting password or passkey credentials.
model AdminAccount {
  adminId           String   @id @default(cuid()) @map("admin_id")
  scopeKey          String   @unique @default("instance") @map("scope_key")
  displayName       String   @default("Administrator") @map("display_name")
  credentialVersion Int      @default(1) @map("credential_version")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  credentials AdminCredential[]
  sessions    AdminSession[]

  @@map("admin_accounts")
}

model AdminCredential {
  credentialId       String    @id @default(cuid()) @map("credential_id")
  adminId             String    @map("admin_id")
  kind                String
  passwordHash        String?   @map("password_hash")
  passkeyCredentialId String?   @unique @map("passkey_credential_id")
  passkeyPublicKey    Bytes?    @map("passkey_public_key")
  passkeySignCount    BigInt?   @map("passkey_sign_count")
  passkeyTransports   Json?     @map("passkey_transports")
  createdAt           DateTime  @default(now()) @map("created_at")
  lastUsedAt          DateTime? @map("last_used_at")
  revokedAt           DateTime? @map("revoked_at")

  admin AdminAccount @relation(fields: [adminId], references: [adminId], onDelete: Cascade)

  @@index([adminId, kind, revokedAt])
  @@map("admin_credentials")
}

// Session and CSRF secrets are never persisted in plaintext. Each session has
// its own identity so it can be listed and revoked without affecting others.
model AdminSession {
  sessionId     String    @id @default(cuid()) @map("session_id")
  adminId       String    @map("admin_id")
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  userAgent     String?   @map("user_agent")
  ipAddressHash String?   @map("ip_address_hash")

  admin AdminAccount @relation(fields: [adminId], references: [adminId], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// A publication is a stable, immutable identity. User-facing draft/editor
// models remain separate; only explicit publication revisions belong here.
model Publication {
  publicationId  String                @id @default(cuid()) @map("publication_id")
  publicationKey String                @unique @map("publication_key")
  createdAt      DateTime              @default(now()) @map("created_at")
  revisions      PublicationRevision[]

  @@map("publications")
}

// Permanent command receipts, independent of publication/event retention.
// Keys are hashed; results contain identifiers/checksums, never draft data.
model PublicationCommand {
  keyHash String @id @map("key_hash")
  requestHash String @map("request_hash")
  result Json?
  @@map("publication_commands")
}

// Revisions are append-only snapshots. The database migration rejects UPDATEs;
// retention may delete old, unreferenced revisions according to the policy in
// PublicationCleanupService.
model PublicationRevision {
  publicationRevisionId String   @id @default(cuid()) @map("publication_revision_id")
  publicationId         String   @map("publication_id")
  revision              Int
  protocolVersion       String   @map("protocol_version")
  content               Json
  contentHash           String   @map("content_hash")
  publishedAt           DateTime @default(now()) @map("published_at")
  createdAt             DateTime @default(now()) @map("created_at")

  publication           Publication              @relation(fields: [publicationId], references: [publicationId], onDelete: Cascade)
  desiredByDevices      DevicePublicationState[] @relation("DesiredPublicationRevision")
  acknowledgedByDevices DevicePublicationState[] @relation("AcknowledgedPublicationRevision")
  playlistEntries       PublishedPlaylistEntry[]

  @@unique([publicationId, revision])
  @@index([publicationId, publishedAt])
  @@map("publication_revisions")
}

// Delivery intent and observed device state deliberately use different foreign
// keys so a slow/offline device can acknowledge an older revision while a newer
// one is already desired.
model DevicePublicationState {
  deviceId                          Int       @id @map("device_id")
  desiredSequence                   Int       @default(0) @map("desired_sequence")
  desiredPublicationRevisionId      String?   @map("desired_publication_revision_id")
  acknowledgedPublicationRevisionId String?   @map("acknowledged_publication_revision_id")
  desiredAt                         DateTime? @map("desired_at")
  acknowledgedAt                    DateTime? @map("acknowledged_at")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  device               Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  desiredRevision      PublicationRevision? @relation("DesiredPublicationRevision", fields: [desiredPublicationRevisionId], references: [publicationRevisionId], onDelete: Restrict)
  acknowledgedRevision PublicationRevision? @relation("AcknowledgedPublicationRevision", fields: [acknowledgedPublicationRevisionId], references: [publicationRevisionId], onDelete: Restrict)

  @@index([desiredPublicationRevisionId])
  @@index([acknowledgedPublicationRevisionId])
  @@map("device_publication_states")
}

// Explicit immutable playlist releases. Source IDs are provenance, not live draft FKs.
model PublishedPlaylist {
  id String @id @default(cuid())
  playlistId Int @map("playlist_id")
  revision Int
  contentHash String @map("content_hash")
  publishedAt DateTime @default(now()) @map("published_at")
  entries PublishedPlaylistEntry[]
  playbacks PlaybackState[]
  @@unique([playlistId, revision])
  @@map("published_playlists")
}

model PublishedPlaylistEntry {
  playlistRevisionId String @map("playlist_revision_id")
  ordinal Int
  itemId Int @map("item_id")
  durationMs Int? @map("duration_ms")
  publicationRevisionId String @map("publication_revision_id")
  playlist PublishedPlaylist @relation(fields: [playlistRevisionId], references: [id], onDelete: Restrict)
  publication PublicationRevision @relation(fields: [publicationRevisionId], references: [publicationRevisionId], onDelete: Restrict)
  @@id([playlistRevisionId, ordinal])
  @@unique([playlistRevisionId, itemId])
  @@index([publicationRevisionId])
  @@map("published_playlist_entries")
}

model PlaybackState {
  id String @id @default(cuid())
  deviceId Int @unique @map("device_id")
  playlistRevisionId String @map("playlist_revision_id")
  version Int
  status String
  anchorIndex Int @map("anchor_index")
  anchorAt DateTime @map("anchor_at")
  elapsedMs Float @map("elapsed_ms")
  evaluatedAt DateTime @map("evaluated_at")
  currentItemId Int? @map("current_item_id")
  nextTransitionAt DateTime? @map("next_transition_at")
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  playlist PublishedPlaylist @relation(fields: [playlistRevisionId], references: [id], onDelete: Restrict)
  @@index([status, nextTransitionAt])
  @@map("playback_states")
}

// Permanent hashed command receipts survive draft deletion and event retention.
model PlaybackCommand {
  keyHash String @id @map("key_hash")
  requestHash String @map("request_hash")
  result Json?
  @@map("playback_commands")
}

// Durable handoff from domain transactions to the later WP-16 dispatcher.
// Status values and numeric invariants are additionally constrained by SQL.
model OutboxEvent {
  eventId        String    @id @default(cuid()) @map("event_id")
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  aggregateRevision String? @map("aggregate_revision")
  claimToken     String?   @map("claim_token")
  claimOwner     String?   @map("claim_owner")
  claimUntil     DateTime? @map("claim_until")
  payloadVersion Int       @default(1) @map("payload_version")
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  processedAt    DateTime? @map("processed_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([status, claimUntil])
  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("outbox_events")
}

// Revision counters/tombstones are independent of event retention and row deletion.
model OutboxAggregate {
  aggregateType String @map("aggregate_type")
  aggregateId String @map("aggregate_id")
  revision Int @default(0)
  @@id([aggregateType, aggregateId])
  @@map("outbox_aggregates")
}

// A small permanent idempotency receipt; payloads are retained with the event only.
model OutboxEffect {
  key String @id
  eventId String @unique @map("event_id")
  completedAt DateTime? @map("completed_at")
  deliveries OutboxDelivery[]
  targets OutboxTarget[]
  @@map("outbox_effects")
}

model OutboxDelivery {
  deliveryId String @id @default(cuid()) @map("delivery_id")
  effectKey String @map("effect_key")
  deviceId Int @map("device_id")
  // Retry snapshot of the existing browser contract, not a publication/render cache.
  presentation Json?
  effect OutboxEffect @relation(fields: [effectKey], references: [key], onDelete: Cascade)
  @@unique([effectKey, deviceId])
  @@map("outbox_deliveries")
}

model OutboxConsumer {
  consumerId String @id @map("consumer_id")
  expiresAt DateTime @map("expires_at")
  @@map("outbox_consumers")
}

model OutboxTarget {
  effectKey String @map("effect_key")
  consumerId String @map("consumer_id")
  delivered Boolean @default(false)
  attemptToken String? @map("attempt_token")
  lastError String? @map("last_error")
  effect OutboxEffect @relation(fields: [effectKey], references: [key], onDelete: Cascade)
  @@id([effectKey, consumerId])
  @@index([consumerId, delivered])
  @@map("outbox_targets")
}

model Model {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  label       String
  width       Int
  height      Int
  description String?
  mimeType    String    @default("image/png") @map("mime_type")
  colors      Int       @default(2)
  bitDepth    Int       @default(1) @map("bit_depth")
  rotation    Int       @default(0)
  offsetX     Int       @default(0) @map("offset_x")
  offsetY     Int       @default(0) @map("offset_y")
  kind        String    @default("terminus")
  scaleFactor Float     @default(1.0) @map("scale_factor")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  devices Device[]
  screens Screen[]

  @@map("models")
}

model Screen {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  modelId      Int?     @map("model_id")
  isPublic     Boolean  @default(false) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  model         Model?         @relation(fields: [modelId], references: [id])
  playlistItems PlaylistItem[]

  @@map("screens")
}

model Playlist {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  isActive     Boolean  @default(false) @map("is_active")
  // TRMNL X only: advance to the next screen on each device poll (middle-tap or on-schedule).
  advanceOnTap Boolean  @default(false) @map("advance_on_tap")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items   PlaylistItem[]
  devices Device[]

  @@map("playlists")
}

model PlaylistItem {
  id             Int      @id @default(autoincrement())
  playlistId     Int      @map("playlist_id")
  screenId       Int?     @map("screen_id")
  screenDesignId Int?     @map("screen_design_id")
  order          Int      @default(0)
  duration       Int?     @default(60) // seconds; null = no auto-advance (stay until a touch tap)
  createdAt      DateTime @default(now()) @map("created_at")

  pluginInstanceId Int? @map("plugin_instance_id")

  playlist       Playlist        @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  screen         Screen?         @relation(fields: [screenId], references: [id], onDelete: Cascade)
  screenDesign   ScreenDesign?   @relation(fields: [screenDesignId], references: [id], onDelete: Cascade)
  pluginInstance PluginInstance? @relation(fields: [pluginInstanceId], references: [id], onDelete: Cascade)

  @@map("playlist_items")
}

model Extension {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String // webhook, polling, custom
  config      Json // JSON configuration
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("extensions")
}

// ========================
// Data Source & Custom Widget Models
// ========================

// Data Source - external API or RSS feed configuration
model DataSource {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  type            String // "json" | "rss"
  url             String // API endpoint or RSS feed URL
  method          String    @default("GET") // HTTP method for JSON APIs
  headers         Json? // Custom headers (e.g., API keys)
  refreshInterval Int       @default(300) @map("refresh_interval") // Seconds between fetches
  jsonPath        String?   @map("json_path") // JSONPath expression to extract data
  isActive        Boolean   @default(true) @map("is_active")
  lastFetchedAt   DateTime? @map("last_fetched_at")
  lastData        Json?     @map("last_data") // Cached response data
  lastError       String?   @map("last_error") // Last fetch error message
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customWidgets CustomWidget[]

  @@map("data_sources")
}

// Custom Widget - user-defined widget using data from a DataSource
model CustomWidget {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  dataSourceId Int      @map("data_source_id")
  displayType  String // "template" | "value" | "list" | "title-value"
  template     String? // Template string for "template" display type
  config       Json // Layout config (fontSize, alignment, etc.) — defaulted to {} in app code (SQLite rejects DB-level Json default)
  minWidth     Int      @default(100) @map("min_width")
  minHeight    Int      @default(50) @map("min_height")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@map("custom_widgets")
}

model Firmware {
  id           Int      @id @default(autoincrement())
  version      String   @unique
  downloadUrl  String   @map("download_url")
  releaseNotes String?  @map("release_notes")
  isStable     Boolean  @default(false) @map("is_stable")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("firmware")
}

model DeviceLog {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @map("device_id")
  level     String // info, warning, error
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_logs")
}

// ========================
// Screen Designer Models
// ========================

// Widget Template - defines available widget types
model WidgetTemplate {
  id            Int      @id @default(autoincrement())
  name          String   @unique // e.g., "clock", "weather", "text"
  label         String // Display name: "Live Clock", "Weather"
  description   String?
  category      String // "time", "weather", "content", "system"
  defaultConfig Json // Default configuration for this widget type
  minWidth      Int      @default(100) @map("min_width")
  minHeight     Int      @default(50) @map("min_height")
  createdAt     DateTime @default(now()) @map("created_at")

  widgets ScreenWidget[]

  @@map("widget_templates")
}

// Screen Design - a designed screen with widgets
model ScreenDesign {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  width       Int      @default(800)
  height      Int      @default(480)
  background  String   @default("#FFFFFF") // white for e-ink
  isTemplate  Boolean  @default(false) @map("is_template")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  widgets       ScreenWidget[]
  assignments   DeviceScreenAssignment[]
  playlistItems PlaylistItem[]

  @@map("screen_designs")
}

// Widget instance on a screen
model ScreenWidget {
  id             Int      @id @default(autoincrement())
  screenDesignId Int      @map("screen_design_id")
  templateId     Int      @map("template_id")
  x              Int      @default(0)
  y              Int      @default(0)
  width          Int      @default(200)
  height         Int      @default(100)
  rotation       Int      @default(0) // Rotation in degrees (0, 90, 180, 270, or any angle)
  config         Json // Widget-specific config (timezone, location, etc.)
  zIndex         Int      @default(0) @map("z_index")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  screenDesign ScreenDesign   @relation(fields: [screenDesignId], references: [id], onDelete: Cascade)
  template     WidgetTemplate @relation(fields: [templateId], references: [id])

  @@map("screen_widgets")
}

// Device to Screen Design assignment
model DeviceScreenAssignment {
  id             Int      @id @default(autoincrement())
  deviceId       Int      @map("device_id")
  screenDesignId Int      @map("screen_design_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  screenDesign ScreenDesign @relation(fields: [screenDesignId], references: [id], onDelete: Cascade)

  @@unique([deviceId, screenDesignId])
  @@map("device_screen_assignments")
}

// Application Settings - key/value store for configuration
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String // Stored as encrypted string for sensitive values
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Blocked devices - prevents auto-provisioning of deleted devices
model BlockedDevice {
  id         Int      @id @default(autoincrement())
  macAddress String   @unique @map("mac_address")
  reason     String? // Why device was blocked (e.g., "deleted by admin")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("blocked_devices")
}

// ========================
// Plugin System Models
// ========================

// Plugin - a reusable plugin definition (built-in from TRMNL or user-created)
model Plugin {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  icon        String? // emoji or image URL
  category    String  @default("custom") // news, productivity, weather, social, finance, system, custom

  // Data fetching configuration
  dataStrategy    String  @default("polling") @map("data_strategy") // polling | webhook | static
  dataUrl         String? @map("data_url") // supports {{setting}} interpolation
  dataMethod      String  @default("GET") @map("data_method")
  dataHeaders     Json?   @map("data_headers") // supports {{setting}} interpolation
  dataPath        String? @map("data_path") // JSONPath to extract from response
  dataTransform   String? @map("data_transform") // JS script to transform fetched data into locals
  refreshInterval Int     @default(300) @map("refresh_interval") // seconds

  // Liquid templates for 4 layout sizes (matching TRMNL)
  markupFull           String? @map("markup_full")
  markupHalfHorizontal String? @map("markup_half_horizontal")
  markupHalfVertical   String? @map("markup_half_vertical")
  markupQuadrant       String? @map("markup_quadrant")

  // Settings schema: [{key, label, type, options?, required?, encrypted?, default?}]
  settingsSchema Json? @map("settings_schema")

  // OAuth (for plugins that require OAuth2 authentication)
  oauthProvider String? @map("oauth_provider") // "google" | "spotify" | "strava" etc.
  oauthScopes   String? @map("oauth_scopes") // space-separated scopes

  // Metadata
  isInstalled Boolean @default(false) @map("is_installed")
  isBuiltin   Boolean @default(false) @map("is_builtin")
  source      String  @default("inker") // "inker" | "trmnl"
  sourceUrl   String? @map("source_url") // GitHub URL of original plugin
  sourceHash  String? @map("source_hash") // hash for detecting updates
  version     String?

  instances PluginInstance[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("plugins")
}

// Plugin Instance - a configured instance of a plugin (with user settings and cached data)
model PluginInstance {
  id       Int     @id @default(autoincrement())
  pluginId Int     @map("plugin_id")
  name     String? // optional custom name for this instance

  settings          Json // user settings (non-sensitive) — defaulted to {} in app code (SQLite rejects DB-level Json default)
  settingsEncrypted Json @map("settings_encrypted") // encrypted settings (API keys) — defaulted to {} in app code

  // OAuth tokens (encrypted)
  oauthToken        String?   @map("oauth_token") // encrypted access token
  oauthRefreshToken String?   @map("oauth_refresh_token") // encrypted refresh token
  oauthExpiresAt    DateTime? @map("oauth_expires_at")

  // Cached data (the locals hash)
  lastData      Json?     @map("last_data")
  lastFetchedAt DateTime? @map("last_fetched_at")
  lastError     String?   @map("last_error")

  plugin        Plugin         @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  playlistItems PlaylistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plugin_instances")
}
