{
  "name": "@inker/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent network and domain contracts for Inker",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "22.22.3"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:esm && bun run build:cjs",
    "build:types": "tsc --project tsconfig.build.json",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --format esm --target browser",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --target node",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "~5.9.3"
  }
}
