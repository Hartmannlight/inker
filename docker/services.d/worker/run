#!/command/with-contenv sh
set -e
exec 2>&1

if [ ! -f /run/inker-init.ready ]; then
    echo "[worker] Fatal: shared initialization did not complete"
    exit 1
fi
export DATABASE_URL=file:/app/uploads/inker.db
export INKER_INSTANCE_SECRET_PATH="${INKER_INSTANCE_SECRET_PATH:-/app/secrets/instance.json}"
export INKER_RENDER_CACHE_PATH="${INKER_RENDER_CACHE_PATH:-/app/render-cache}"
export HOME=/tmp/inker-home
cd /app

# Independently supervised: s6-svc -d/-u /run/service/worker never restarts API.
echo "[worker] Starting Inker worker..."
exec s6-setuidgid inker bun run dist/worker.js
