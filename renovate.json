{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Hartmannlight/pipeline-toolkit"
  ],
  "packageRules": [
    {
      "description": "Keep the Bun runtime, packageManager, engines and Docker image in one tested update.",
      "matchPackageNames": [
        "bun",
        "oven/bun"
      ],
      "groupName": "Bun runtime"
    }
  ]
}
